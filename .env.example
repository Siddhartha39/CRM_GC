# Galaxy Computers CRM - Example Environment Configuration
# Copy this file to .env and insert your Firebase Project credentials

VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_MEASUREMENT_ID="your-measurement-id"

# App Settings
VITE_APP_TITLE="Galaxy Computers CRM"
VITE_SHOP_CITY="Kanpur, Uttar Pradesh, India"
VITE_DEFAULT_TIMEZONE="Asia/Kolkata"
